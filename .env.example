# Copy to .env (never commit .env). Every key is optional: without one, that feature runs in mock mode.

# Gemini, from Google AI Studio: https://aistudio.google.com/apikey  (use the hackathon credits)
GEMINI_API_KEY=
# Optional. Default gemini-3.5-flash-lite (fast, cheap). `npm run check:ai` lists what your key can use.
GEMINI_MODEL=

# Gradium: speech-to-text for the scroll incantations, plus text-to-speech and voice design for the tools.
# Without it the browser's own speech recognition hears the incantations. The gods' lines are recorded files either way.
GRADIUM_API_KEY=
# Optional default voice id (`npm run voices`). Default: Emma, YTpq7expH9539ERJ.
GRADIUM_VOICE_ID=
